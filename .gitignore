```gitignore
# Environnements virtuels Python
.venv/
venv/

# Fichiers temporaires Python
__pycache__/
*.py[cod]

# Base de données locale SQLite
db.sqlite3

# Dépendances et fichiers générés du frontend
node_modules/
dist/

# Fichiers de cache et de compilation
*.tsbuildinfo

# Fichiers système macOS
.DS_Store

# Variables d'environnement et informations sensibles
.env
.env.*
!.env.example
```
